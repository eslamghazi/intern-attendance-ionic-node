# ===== Public client vars — the APP needs the VITE_ prefix (Vite exposes ONLY VITE_*) =====
# API base URL, no trailing slash (see ../server). This is the only backend
# setting the app has; there is no Supabase project any more.
VITE_API_URL=http://localhost:8787/api/v1

# External host for the large ML assets (models + mediapipe wasm), no trailing slash.
# Leave empty to serve them from this app's own public/ folder.
# Point it at another repo via jsDelivr, e.g.:
#   VITE_MODEL_BASE_URL=https://cdn.jsdelivr.net/gh/YOUR_USER/YOUR_MODELS_REPO@v1
# The remote must keep this exact layout:
#   <base>/models/mobilefacenet.onnx
#   <base>/models/face_landmarker.task
#   <base>/mediapipe/wasm/<the 6 vision_wasm_* files>
VITE_MODEL_BASE_URL=
