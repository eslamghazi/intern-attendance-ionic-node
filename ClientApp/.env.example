# ==============================================================================
# إعدادات بناء الواجهة الأمامية (Frontend ClientApp Build Variables)
# ==============================================================================
# ملاحظة: جميع متغيرات Vite يجب أن تبدأ بـ VITE_ ليتم تضمينها في حزمة الـ Build.

# رابط الـ API للواجهة الأمامية:
# - في الإنتاج المدمج (Node + Nginx على نفس الدومين): استخدم المسار النسبي /api/v1
# - إذا كان السيرفر على دومين أو منفذ منفصل: اكتب الرابط كاملاً مثل https://internatten.kfsnur.com/api/v1
VITE_API_URL=/api/v1

# رابط استضافة نماذج الذكاء الاصطناعي (MediaPipe & Face Recognition Models):
# - القيمة الافتراضية تسحب النماذج من CDN سريع (jsDelivr)
# - اتركه فارغاً لاستخدام الـ CDN الافتراضي، أو حدد رابط الـ CDN الخاص بك
VITE_MODEL_BASE_URL=https://cdn.jsdelivr.net/gh/eslamghazi/redirctDownInternAttendance@V1

