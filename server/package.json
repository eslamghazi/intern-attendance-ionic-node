{
  "name": "intern-attendance-server",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "author": "Calaix AI (https://calaixai.com)",
  "license": "UNLICENSED",
  "description": "Node API for the intern-attendance app — replaces Supabase (PostgREST + GoTrue + Storage + Edge Functions). The Postgres schema, its 36 SQL functions and its 51 RLS policies are kept as-is.",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "build": "tsc",
    "start": "node dist/main.js",
    "migrate": "node scripts/migrate.mjs",
    "migrate:status": "node scripts/migrate.mjs --status",
    "seed:superadmin": "node scripts/seed-superadmin.mjs",
    "test": "vitest run",
    "test.watch": "vitest",
    "import:data": "node scripts/import-from-supabase.mjs",
    "import:storage": "node scripts/import-storage.mjs",
    "db:pull": "drizzle-kit pull --config drizzle.pull.config.ts && node scripts/patch-drizzle-output.mjs",
    "db:generate": "drizzle-kit generate && node scripts/patch-drizzle-output.mjs",
    "db:push": "node -e \"console.error('REFUSED: drizzle-kit push would rewrite the live schema from the entities. Add a .sql file in db/forward instead — see drizzle.config.ts.'); process.exit(1)\"",
    "db:extract": "node scripts/extract-programmables.mjs",
    "verify:schema": "node scripts/verify-schema.mjs",
    "test:e2e": "node test/e2e/run.mjs",
    "test:e2e:prod": "node test/e2e/run.mjs --prod"
  },
  "dependencies": {
    "@fastify/cors": "^10.0.1",
    "@fastify/helmet": "^13.1.1",
    "@fastify/rate-limit": "^11.2.0",
    "@fastify/static": "^10.1.3",
    "@nestjs/common": "^12.0.1",
    "@nestjs/core": "^12.0.1",
    "@nestjs/platform-express": "^12.0.1",
    "@nestjs/platform-fastify": "^12.0.1",
    "@nestjs/swagger": "^12.0.1",
    "bcryptjs": "^2.4.3",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "cors": "^2.8.6",
    "date-fns": "^4.4.0",
    "date-fns-tz": "^3.2.0",
    "dotenv": "^16.4.7",
    "drizzle-orm": "^0.45.2",
    "express": "^5.2.1",
    "express-rate-limit": "^8.7.0",
    "fastify": "^5.2.1",
    "fastify-plugin": "^5.0.1",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.2",
    "pg": "^8.13.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "umzug": "^3.8.3",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.19",
    "@types/diff": "^7.0.2",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/node": "^22.10.5",
    "@types/pg": "^8.11.10",
    "diff": "^9.0.0",
    "drizzle-kit": "^0.31.10",
    "pino-pretty": "^13.0.0",
    "tsx": "^4.19.2",
    "typescript": "~5.9.0",
    "vitest": "^4.1.11"
  }
}
