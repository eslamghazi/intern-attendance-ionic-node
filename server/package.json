{
  "name": "intern-attendance-server",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "author": "Calaix AI (https://calaixai.com)",
  "license": "UNLICENSED",
  "description": "Node API for the intern-attendance app — NestJS + Fastify over plain PostgreSQL, with no extensions. Authorization lives in the API; the database has no RLS and no per-request role switching.",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "clean": "node -e \"import('node:fs').then(fs => fs.rmSync('dist', { recursive: true, force: true }))\"",
    "build": "npm run clean && tsc",
    "start": "node dist/main.js",
    "migrate": "node scripts/migrate.mjs",
    "migrate:status": "node scripts/migrate.mjs --status",
    "superadmin:password": "node scripts/superadmin-password.mjs",
    "superadmin:backup": "node scripts/superadmin-backup.mjs",
    "superadmin:restore": "node scripts/superadmin-restore.mjs",
    "test": "vitest run",
    "test.watch": "vitest",
    "db:generate": "drizzle-kit generate",
    "db:push": "node -e \"console.error('REFUSED: drizzle-kit push diffs against the LIVE database and would drop the triggers it cannot see. Change the models and run db:generate.'); process.exit(1)\"",
    "test:e2e": "node test/e2e/run.mjs",
    "test:e2e:prod": "node test/e2e/run.mjs --prod",
    "test:e2e:local": "node test/e2e/run.mjs --local"
  },
  "dependencies": {
    "@fastify/cors": "^10.0.1",
    "@fastify/helmet": "^13.1.1",
    "@fastify/rate-limit": "^11.2.0",
    "@fastify/static": "^10.1.3",
    "@nestjs/common": "^12.0.1",
    "@nestjs/core": "^12.0.1",
    "@nestjs/platform-fastify": "^12.0.1",
    "@nestjs/swagger": "^12.0.1",
    "bcryptjs": "^2.4.3",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "date-fns": "^4.4.0",
    "date-fns-tz": "^3.2.0",
    "dotenv": "^16.4.7",
    "drizzle-orm": "^0.45.2",
    "exceljs": "^4.4.0",
    "fastify": "^5.2.1",
    "fastify-plugin": "^5.0.1",
    "jsonwebtoken": "^9.0.2",
    "pg": "^8.13.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "umzug": "^3.8.3",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/diff": "^7.0.2",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/node": "^22.10.5",
    "@types/pg": "^8.11.10",
    "diff": "^9.0.0",
    "drizzle-kit": "^0.31.10",
    "pino-pretty": "^13.0.0",
    "tsx": "^4.19.2",
    "typescript": "~5.9.0",
    "vitest": "^4.1.11"
  }
}
