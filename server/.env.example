# ===== Database =====
# Must be the OWNER of the app tables: the owner bypasses RLS, which is what
# gives us the "service role" path. Per-request the API drops into `anon` /
# `authenticated` so the 51 policies apply (see src/db/rls.ts).
DATABASE_URL=postgres://attendance:password@127.0.0.1:5432/attendance
# Set to 1 when the DB requires TLS (managed Postgres / remote host).
DATABASE_SSL=0

# ===== Auth =====
# HS256 secret used to sign AND verify every app token. Carried over from the
# old Supabase `APP_JWT_SECRET` so tokens already on members' phones stay valid
# through the cutover. Rotate only when you are ready to log everyone out.
APP_JWT_SECRET=
# How long an ACCESS token lives. Short on purpose: it cannot be revoked, so
# this is the window in which a stolen one is still worth something.
ACCESS_TOKEN_TTL_MINUTES=15

# How long someone stays signed in without typing a password. The refresh token
# is rotated on every use and can be revoked, so this is an idle limit rather
# than a fixed lifetime.
REFRESH_TOKEN_TTL_DAYS=30

# ===== HTTP =====
PORT=8787
HOST=0.0.0.0
NODE_ENV=development
# Comma-separated, and it must include the NATIVE origins, which are not web
# URLs: Capacitor serves the bundle from a local scheme and that is the Origin
# the API sees — https://localhost on Android (its default androidScheme) and
# capacitor://localhost on iOS. Miss either and the mobile app is blocked by
# CORS on its very first request. Add your web origin here too.
CORS_ORIGINS=http://localhost:5173,https://localhost,capacitor://localhost

# ===== Storage (S3 / MinIO) =====
# The bytes live in an S3-compatible store; the metadata stays in
# storage.objects so the bucket policies from the migrations remain
# authoritative. Presigned URLs come from the store — nothing here signs URLs.
S3_ENDPOINT=127.0.0.1
S3_PORT=9000
S3_USE_SSL=0
S3_ACCESS_KEY=attendance
S3_SECRET_KEY=attendance_dev_secret
# Host a PHONE can reach. Presigned URLs are handed to clients, so this must not
# be the docker-internal name.
S3_PUBLIC_URL=http://localhost:9000
# Seconds a signed download URL stays valid.
S3_URL_TTL=3600
