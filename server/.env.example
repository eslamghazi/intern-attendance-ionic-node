# =============================================================================
#  intern-attendance / server — نموذج ملف البيئة
#
#  للتطوير المحلي فقط. في الإنتاج يُقرأ ‎.env‎ من جذر المشروع، وهذا الملف
#  يغطي نفس المتغيرات لمن يشغّل الخادم وحده:   cp .env.example .env
#
#  لتوليد الأسرار العشوائية:   node scripts/generate-secrets.mjs
#  لا تضع أسرارًا حقيقية هنا — الملف مرفوع على Git.
# =============================================================================

# --- قاعدة البيانات --------------------------------------------------------
# المستخدم هنا يجب أن يكون **مالك الجداول**. التطبيق يتصل بمستخدم واحد ثابت،
# لا يبدّل الدور، ولا يعتمد على أي GRANT: صلاحياته ضمنية بحكم الملكية.
# لا يحتاج SUPERUSER ولا CREATEROLE في أي لحظة — لا عند الترحيل ولا بعده.
# القاعدة لا تحتاج أي extension. تجهيز الدور والقاعدة
# مشروح في README، قسم "التشغيل على PostgreSQL عادي".
DATABASE_URL=postgresql://intern_app:CHANGE_ME@127.0.0.1:5432/intern_atten
# اجعلها 1 إذا كانت القاعدة تفرض TLS (استضافة مُدارة أو خادم بعيد).
DATABASE_SSL=0

# --- المصادقة --------------------------------------------------------------
# مفتاح توقيع رموز الدخول والتحقق منها (HS256). 32 حرفًا على الأقل، وإلا رفض
# التطبيق الإقلاع. تغييره يُبطل الجلسات القائمة، ويجدّدها العميل تلقائيًا برمز
# التحديث دون أن يُطالب أحد بكلمة المرور.
APP_JWT_SECRET=
# عمر رمز الدخول بالدقائق. قصير عمدًا: لا يمكن إبطاله، فهذه نافذة خطره إن سُرق.
ACCESS_TOKEN_TTL_MINUTES=15
# مدة بقاء المستخدم مسجّلًا بلا كلمة مرور. الرمز يُدوَّر عند كل استخدام ويمكن
# إبطاله، فهذه مهلة خمول لا عمر ثابت.
REFRESH_TOKEN_TTL_DAYS=30

# --- HTTP ------------------------------------------------------------------
PORT=8787
HOST=0.0.0.0
NODE_ENV=development
# مصادر CORS المسموح بها، مفصولة بفواصل. يجب أن تشمل مصادر التطبيق الأصلية —
# وهي ليست عناوين ويب: Capacitor يقدّم الحزمة من مخطط محلي، وهو المصدر الذي
# يراه الخادم. https://localhost لأندرويد و capacitor://localhost لـ iOS.
# إغفال أيهما يمنع تطبيق الهاتف من أول طلب. أضف مصدر الويب هنا أيضًا.
CORS_ORIGINS=http://localhost:5173,https://localhost,capacitor://localhost
# المسار العام للـ API، ليكون الرابط الموقّع كاملًا بما يكفي ليطلبه الهاتف.
# اتركه فارغًا إن كان التطبيق والـ API على نفس الأصل.
API_PUBLIC_PATH=/api/v1
# مسار ملفات الواجهة المبنية (مثل ‎../ClientApp/dist‎). اختياري.
# CLIENT_DIST_PATH=

# --- الوسائط (صور الوجه) ---------------------------------------------------
# مجلد الملفات على القرص. الصور والقوالب البيومترية تُحفظ هنا، لا في القاعدة،
# ويجب أن يكون **خارج جذر الويب**: مجلد يخدمه Nginx مباشرة يُبطل توقيع الروابط.
# لا يوجد S3 ولا MinIO في هذا النظام — الملفات محلية وروابطها موقّعة بـ HMAC.
STORAGE_DIR=./storage-data
# مدة صلاحية رابط الصورة الموقّع بالثواني.
STORAGE_URL_TTL=3600
# مفتاح توقيع روابط الوسائط. منفصل عن APP_JWT_SECRET عمدًا حتى لا يكون تسريب
# رابط صورة خطوةً نحو تزوير جلسة. إن تركته فارغًا يُشتق من APP_JWT_SECRET.
STORAGE_URL_SECRET=

# --- الصيانة المجدولة ---------------------------------------------------------
# المهام يشغّلها التطبيق نفسه (src/infrastructure/scheduler)، لا قاعدة البيانات.
# كل مهمة تأخذ قفلًا استشاريًا باسمها، فتشغيل أكثر من نسخة لا يكرّر العمل.
# اجعلها 0 على نسخة يجب ألّا تشغّل المهام (نسخة ثانية، أو عملية تشخيص مؤقتة).
SCHEDULER_ENABLED=1
# مدة حفظ سجل التدقيق بالأيام. هو دليل: طويل بما يكفي للتحقيق في نزاعات فصل
# دراسي، وقصير بما يكفي ألّا يصير سجلًا دائمًا بتحركات الجميع.
AUDIT_RETENTION_DAYS=365
# مدة حفظ صور التحقق لحظة التسجيل بالأيام. هذه **صور بيومترية** — واحدة عند كل
# حضور وأخرى عند كل انصراف. سبب حفظها هو حسم نزاع على يوم بعينه، وهذا السبب ينتهي.
PROBE_RETENTION_DAYS=90

# --- هوية النظام (اختياري) -------------------------------------------------
# إن تركتها فارغة تُقرأ القيم من قاعدة البيانات / لوحة التحكم.
# ORG_NAME=
# ORG_LOGO_URL=
# TERMINOLOGY=intern

# --- بدء التشغيل ----------------------------------------------------------
# تطبيق الترحيلات المعلّقة تلقائيًا عند تشغيل الـ API. اجعلها 0 إذا كان هناك
# خطوة ترحيل منفصلة تملك المخطط. العمل يتم تحت قفل، فتشغيل عدة نسخ معًا آمن.
AUTO_MIGRATE=1

# --- حساب المشرف العام الأول ----------------------------------------------
# يُنشأ تلقائيًا عند إقلاع الـ API إذا لم يكن موجودًا — لا حاجة لخطوة يدوية.
# الحساب الموجود لا يُلمس أبدًا: هذه أول طريقة للدخول، وليست إدارة لكلمة السر.
# القيم أدناه وهمية، والخادم يرفض تشغيل CHANGE_ME كما هي.
# اتركه فارغًا ولن يُنشأ أي حساب.
SUPERADMIN_NATIONAL_ID=00000000000000
SUPERADMIN_NAME=Super Admin
SUPERADMIN_PASSWORD=CHANGE_ME_AT_LEAST_8_CHARS
