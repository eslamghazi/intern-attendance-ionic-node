# Postgres with everything this schema actually needs.
#
# The stock `postgres` image has none of it. Rather than pull `supabase/postgres`
# — which would keep us tied to the vendor we are leaving — this adds the three
# extensions to the official PostGIS image:
#
#   postgis   branches/geofencing (geofence_check uses ST_DWithin)
#   vector    face_templates embeddings (pgvector)
#   pg_cron   the two scheduled jobs: cleanup-expired-qr, mark-left-work
FROM postgis/postgis:16-3.4

RUN apt-get update \
 && apt-get install -y --no-install-recommends \
      postgresql-16-pgvector \
      postgresql-16-cron \
 && rm -rf /var/lib/apt/lists/*
