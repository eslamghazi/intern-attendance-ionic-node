# Read by `docker compose` only. Copy to .env and fill in.

# Generate all three with:  node server/scripts/generate-secrets.mjs
# Three separate values on purpose — a leak in one must not be a leak in all.

# HS256 secret the ACCESS tokens are signed with.
#
# Access tokens live 15 minutes, so changing this costs almost nothing: every
# app renews within the quarter-hour using its refresh token, which lives in
# the database and is unaffected. That was not true of the old 30-day token,
# where rotating this signed the whole faculty out at once — hence the long
# note that used to be here about cutting over overnight.
#
# Use a FRESH one. The old project's value sat in Supabase's Edge Function
# config and is in this repo's git history.
APP_JWT_SECRET=

# Signs the time-limited image URLs. Deliberately not the same as the one
# above: a signed photo link copied out of a browser must never be a step
# towards forging a session.
STORAGE_URL_SECRET=

# Only ever used inside the Docker network — Postgres publishes no port in
# production. deploy/deploy.sh refuses to start if this is still `change-me`.
POSTGRES_PASSWORD=change-me

# Postgres database connection string (required when running outside Docker Compose,
# or set to point to an external Postgres instance like Neon/Supabase/RDS).
# If unset, automatically derives from POSTGRES_PASSWORD on 127.0.0.1:5432.
# DATABASE_URL=postgres://attendance:change-me@127.0.0.1:5432/attendance

# Where the app is published. In production this binds to 127.0.0.1 only and
# nginx proxies to it — see docker-compose.prod.yml and deploy/aapanel-nginx.conf.
WEB_PORT=8080

# Session lifetimes. The defaults are in server/src/env.ts; set them here only
# to override.
#   ACCESS_TOKEN_TTL_MINUTES=15
#   REFRESH_TOKEN_TTL_DAYS=30

# Origins the API accepts cross-origin requests from. The web app is served
# from the same origin as the API and needs no entry; these are the NATIVE
# builds, which Capacitor serves from a local scheme.
CORS_ORIGINS=https://localhost,capacitor://localhost

# Leave unset: the app calls the API at /api/v1 on its own origin. Only set it
# if the API is genuinely on another host — and then add this app's origin to
# CORS_ORIGINS above.
# VITE_API_URL=

# Where the large ML assets are hosted. Empty serves them from the app itself.
# VITE_MODEL_BASE_URL=
