NODE_ENV=production
PORT=8080
WEB_PORT=8080

DATABASE_URL=postgres://attendance:YOUR_POSTGRES_PASSWORD@127.0.0.1:5432/attendance
POSTGRES_PASSWORD=YOUR_POSTGRES_PASSWORD

APP_JWT_SECRET=YOUR_APP_JWT_SECRET_AT_LEAST_32_CHARS
STORAGE_URL_SECRET=YOUR_STORAGE_URL_SECRET_AT_LEAST_32_CHARS

CORS_ORIGINS=https://localhost,capacitor://localhost

# --- إعدادات بناء الواجهة الأمامية (Frontend Build Variables) ---
# يتم تضمين هذه المتغيرات تلقائياً داخل حزمة الـ Frontend عند تشغيل npm run build
VITE_API_URL=/api/v1
VITE_MODEL_BASE_URL=https://cdn.jsdelivr.net/gh/eslamghazi/redirctDownInternAttendance@V1

# --- إعدادات هوية النظام الاختيارية (Optional Branding from .env) ---
# إذا تركتها فارغة، ستُقرأ القيم بالكامل من قاعدة البيانات / لوحة التحكم
# ORG_NAME=
# ORG_LOGO_URL=
# TERMINOLOGY=intern

# --- بيانات المشرف العام لإنشاء الحساب لأول مرة (npm run seed:superadmin) ---
SUPERADMIN_NATIONAL_ID=YOUR_14_DIGIT_NATIONAL_ID
SUPERADMIN_PASSWORD=YOUR_STRONG_PASSWORD_AT_LEAST_8_CHARS



