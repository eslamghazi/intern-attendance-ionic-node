# =============================================================================
# 1. الإعدادات المطلوبة إجبارياً (REQUIRED - لا يعمل السيرفر بدونها)
# =============================================================================

# [مطلوب] رابط الاتصال بقاعدة بيانات PostgreSQL
# إذا كانت القاعدة على نفس السيرفر (aaPanel أو Docker محلي):
DATABASE_URL=postgres://attendance:YOUR_POSTGRES_PASSWORD@127.0.0.1:5432/attendance

# كلمة مرور قاعدة البيانات (مطلوبة عند تشغيل Docker Compose أو السكربتات)
POSTGRES_PASSWORD=YOUR_POSTGRES_PASSWORD

# [مطلوب] مفتاح تشفير الجلسات والتوكنات (JWT Secret) - يجب ألا يقل عن 32 حرفاً
# يمكنك توليد مفاتيح عشوائية قوية بتشغيل الأمر: node scripts/generate-secrets.mjs
APP_JWT_SECRET=YOUR_RANDOM_SECRET_AT_LEAST_32_CHARS_LONG


# =============================================================================
# 2. إعدادات الاستضافة الموصى بها (RECOMMENDED FOR AA-PANEL & PRODUCTION)
# =============================================================================

# وضع التشغيل: production
NODE_ENV=production

# منفذ تشغيل التطبيق (يتطابق مع Port في aaPanel Node Project Manager)
PORT=8080
WEB_PORT=8080

# مفتاح توقيع وتشفير روابط الصور والبصمات المؤقتة (يجب ألا يقل عن 32 حرفاً)
# (لو تُرك فارغاً يقوم السيرفر باشتقاق قيمة آمنة تلقائياً من APP_JWT_SECRET)
STORAGE_URL_SECRET=YOUR_STORAGE_URL_SECRET_AT_LEAST_32_CHARS

# النطاقات المسموحة للاتصال عبر CORS (ضرورية لتطبيقات الهواتف Capacitor / Android / iOS)
CORS_ORIGINS=https://localhost,capacitor://localhost


# =============================================================================
# 3. إعدادات متقدمة اختيارية (OPTIONAL - لها قيم افتراضية ممتازة مسبقاً)
# =============================================================================

# تفعيل SSL لقاعدة البيانات: 0 للقواعد المحلية (aaPanel/Docker)، 1 للسحابية (Neon / Supabase)
# DATABASE_SSL=0

# عمر توكن الوصول القصير بالدقائق (الافتراضي: 15 دقيقة)
# ACCESS_TOKEN_TTL_MINUTES=15

# عمر جلسة المستخدم المسجل بالأيام قبل تسجيل الخروج التلقائي (الافتراضي: 30 يوماً)
# REFRESH_TOKEN_TTL_DAYS=30

# مجلد تخزين الصور الحيوية خارج متناول المتصفح المباشر (الافتراضي: ./storage-data)
# STORAGE_DIR=./storage-data
