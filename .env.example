# =============================================================================
#  intern-attendance — ملف البيئة الوحيد للمشروع
#
#  انسخه وعدّله:            cp .env.example .env
#  لتوليد الأسرار:          node server/scripts/generate-secrets.mjs
#
#  لا تضع أسرارًا حقيقية هنا إطلاقًا — هذا الملف مرفوع على Git.
#
#  ملف واحد فقط، في جذر المشروع. يقرأه الخادم عند التشغيل، ويقرأه Vite عند
#  بناء الواجهة (‎ClientApp/vite.config.ts‎ يوجّه ‎envDir‎ إلى هنا). المتغيرات
#  التي لا تبدأ بـ ‎VITE_‎ لا تصل إلى حزمة المتصفح إطلاقًا، فوجود أسرار الـ API
#  في نفس الملف آمن.
# =============================================================================


# =============================================================================
#  الجزء الأول: ما يجب ضبطه — بدونها لا يعمل النظام
# =============================================================================

# --- قاعدة البيانات ---------------------------------------------------------
# المستخدم هنا يجب أن يكون **مالك القاعدة**. التطبيق يتصل بمستخدم واحد ثابت،
# لا يبدّل الدور، ولا يعتمد على أي GRANT: صلاحياته ضمنية بحكم الملكية.
# لا يحتاج SUPERUSER ولا CREATEDB ولا CREATEROLE في أي لحظة.
#
# الصيغة:  postgres://المستخدم:كلمة_المرور@المضيف:المنفذ/اسم_القاعدة
# لو كلمة المرور فيها ‎@‎ أو ‎:‎ أو ‎/‎ أو ‎#‎ فيجب ترميزها URL-encoded.
#
# تجهيز الدور والقاعدة (مرة واحدة):
#   CREATE ROLE اسم_المستخدم LOGIN PASSWORD '...';
#   CREATE DATABASE اسم_القاعدة OWNER اسم_المستخدم;
DATABASE_URL=postgres://CHANGE_ME_USER:CHANGE_ME_PASSWORD@127.0.0.1:5432/CHANGE_ME_DB

# --- مفتاح توقيع الجلسات ----------------------------------------------------
# 32 حرفًا على الأقل وإلا رفض التطبيق الإقلاع. ولّده بالأمر أعلاه.
# تغييره يُبطل رموز الدخول القائمة، ويجدّدها العميل تلقائيًا دون مطالبة أحد
# بكلمة المرور.
APP_JWT_SECRET=

# --- HTTP -------------------------------------------------------------------
NODE_ENV=production
# المنفذ الذي يستمع عليه التطبيق، ويوجّه إليه Nginx.
PORT=8787
# **مهم في الإنتاج**: اجعله 127.0.0.1 خلف Nginx. القيمة الافتراضية في الكود
# هي 0.0.0.0، وتركها يعني أن التطبيق مسموع على كل الواجهات — أي أنه متاح على
# ‎http://<ip>:8787‎ بلا تشفير إن سمح الجدار الناري، متجاوزًا TLS بالكامل.
HOST=127.0.0.1

# --- CORS -------------------------------------------------------------------
# مفصولة بفواصل. يجب أن تشمل نطاقك، **و** مصدرَي تطبيق الهاتف: Capacitor يقدّم
# الحزمة من مخطط محلي وهو المصدر الذي يراه الخادم — ‎https://localhost‎ لأندرويد
# و ‎capacitor://localhost‎ لـ iOS. إغفال أيهما يمنع تطبيق الهاتف من أول طلب.
CORS_ORIGINS=https://CHANGE_ME.example.com,https://localhost,capacitor://localhost

# --- ملفات الوجوه -----------------------------------------------------------
# مجلد على القرص. الصور والقوالب البيومترية تُحفظ هنا لا في القاعدة، ويجب أن
# يكون **خارج جذر الويب**: مجلد يخدمه Nginx مباشرة يُبطل توقيع الروابط.
# استخدم مسارًا مطلقًا في الإنتاج حتى لا يتغيّر بتغيّر مجلد التشغيل.
STORAGE_DIR=./storage-data


# =============================================================================
#  الجزء الثاني: اختيارية — الافتراضي سليم، غيّرها عند الحاجة فقط
# =============================================================================

# اجعلها 1 إذا كانت القاعدة تفرض TLS (استضافة مُدارة أو خادم بعيد).
DATABASE_SSL=0

# عمر رمز الدخول بالدقائق. قصير عمدًا: لا يمكن إبطاله، فهذه نافذة خطره إن سُرق.
ACCESS_TOKEN_TTL_MINUTES=15
# مدة بقاء المستخدم مسجّلًا بلا كلمة مرور. الرمز يُدوَّر عند كل استخدام ويمكن
# إبطاله، فهذه مهلة خمول لا عمر ثابت.
REFRESH_TOKEN_TTL_DAYS=30

# مفتاح توقيع روابط الصور. منفصل عن APP_JWT_SECRET عمدًا حتى لا يكون تسريب
# رابط صورة خطوةً نحو تزوير جلسة. إن تركته فارغًا يُشتق من APP_JWT_SECRET،
# فالنشر الذي لم يضبطه لا يستخدم مفتاحًا قابلًا للتخمين.
STORAGE_URL_SECRET=
# مدة صلاحية رابط الصورة الموقّع بالثواني.
STORAGE_URL_TTL=3600

# المسار العام للـ API، ليكون الرابط الموقّع كاملًا بما يكفي ليطلبه الهاتف.
API_PUBLIC_PATH=/api/v1
# مسار ملفات الواجهة المبنية. اتركه فارغًا: التطبيق يجد ‎public/‎ بجانبه وحده.
# CLIENT_DIST_PATH=

# بديل لـ PORT تستخدمه aaPanel وبعض اللوحات. يُقرأ فقط إذا كان PORT فارغًا.
# WEB_PORT=8787

# --- الصيانة المجدولة -------------------------------------------------------
# المهام يشغّلها التطبيق نفسه لا قاعدة البيانات. كل مهمة تأخذ قفلًا استشاريًا
# باسمها، فتشغيل أكثر من نسخة لا يكرّر العمل. اجعلها 0 على نسخة يجب ألّا
# تشغّل المهام (نسخة ثانية، أو عملية تشخيص مؤقتة).
SCHEDULER_ENABLED=1
# مدة حفظ سجل التدقيق بالأيام. هو دليل: طويل بما يكفي للتحقيق في نزاعات فصل
# دراسي، وقصير بما يكفي ألّا يصير سجلًا دائمًا بتحركات الجميع.
AUDIT_RETENTION_DAYS=365
# مدة حفظ صور التحقق لحظة التسجيل بالأيام. هذه **صور بيومترية** — واحدة عند كل
# حضور وأخرى عند كل انصراف. سبب حفظها حسم نزاع على يوم بعينه، وهذا السبب ينتهي.
PROBE_RETENTION_DAYS=90

# تطبيق الترحيلات المعلّقة تلقائيًا عند تشغيل الـ API. اجعلها 0 إذا كانت هناك
# خطوة ترحيل منفصلة تملك المخطط. العمل يتم تحت قفل، فتشغيل عدة نسخ معًا آمن.
AUTO_MIGRATE=1

# --- هوية النظام ------------------------------------------------------------
# إن تركتها فارغة تُقرأ القيم من قاعدة البيانات / لوحة التحكم.
# ORG_NAME=
# ORG_LOGO_URL=
# TERMINOLOGY=intern


# =============================================================================
#  الجزء الثالث: الواجهة — وقت البناء فقط، لا على الخادم
# =============================================================================
#
#  هذه تُخبز داخل حزمة المتصفح لحظة ‎npm run build‎ على جهازك. ضبطها على
#  الخادم لا يفعل شيئًا: الحزمة تكون قد بُنيت بالفعل.
#
#  ‎VITE_API_URL‎ — **اتركه غير مضبوط.** الافتراضي في الكود هو المسار النسبي
#  ‎/api/v1‎، وهو الصحيح في الحالتين: في الإنتاج التطبيق والـ API على نفس
#  الأصل ويمرّر Nginx المسار ‎/api/‎، وفي التطوير يمرّره خادم Vite إلى المنفذ
#  8787. ضبطه على عنوان مطلق يثبّت نطاق نشرٍ واحد داخل الحزمة ويكسر أي نشر آخر
#  — وضبطه على ‎localhost‎ يجعل التطبيق المنشور يسأل هاتف المستخدم نفسه عن
#  الـ API، وهو ما يظهر كأن الخادم متوقف.
# VITE_API_URL=

#  مصدر نماذج التعرّف على الوجه. اتركه فارغًا لاستخدام الافتراضي.
# VITE_MODEL_BASE_URL=


# =============================================================================
#  المشرف العام — لا إعدادات هنا عن قصد
# =============================================================================
#  أول حساب مشرف عام يُنشأ تلقائيًا عند تشغيل الـ API على قاعدة ليس بها أي
#  مشرف، بكلمة مرور مولّدة تُطبع مرة واحدة وتُكتب في ‎first-superadmin.txt‎
#  بجانب التطبيق. احذف الملف بعد أول دخول.
#
#    npm run superadmin:password   توليد كلمة مرور قوية جديدة وطباعتها
#    npm run superadmin:backup     نسخة احتياطية من حسابات المشرف العام
#    npm run superadmin:restore    استرجاعها
